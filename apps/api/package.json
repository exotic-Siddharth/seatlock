{
  "name": "@seatlock/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false --env-file-if-exists=../../.env src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/scripts/migrate.ts",
    "seed": "tsx --env-file-if-exists=../../.env src/scripts/seed.ts",
    "bench:seed": "tsx --env-file-if-exists=../../.env src/scripts/seed-bench.ts",
    "bench:verify": "tsx --env-file-if-exists=../../.env src/scripts/verify-bench.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.2",
    "@seatlock/shared": "*",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "prom-client": "^15.1.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "eventsource-parser": "^4.1.3",
    "supertest": "^7.3.2",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "vitest": "^5.1.0"
  }
}
