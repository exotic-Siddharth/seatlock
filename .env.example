# Copy to .env at the repo root. Every value below is a development default;
# the API starts without a .env file and generates the secrets per process.

NODE_ENV=development
PORT=4200
DATABASE_URL=postgres://seatlock:seatlock@localhost:55434/seatlock
REDIS_URL=redis://localhost:56381/0
WEB_ORIGIN=http://localhost:5175
LOG_LEVEL=info

# Secrets: at least 32 characters, required when NODE_ENV=production.
QUEUE_TOKEN_SECRET=dev-queue-token-secret-change-me-0123456789
MOCKPAY_WEBHOOK_SECRET=dev-mockpay-webhook-secret-change-me-012345
METRICS_TOKEN=dev-metrics-token-change-me-0123456789abcd

MOCKPAY_WEBHOOK_URL=http://localhost:4200/api/webhooks/mockpay
# Simulated payment latency range, min-max in milliseconds.
MOCKPAY_LATENCY_MS=300-900

# naive | pessimistic | conditional | redis (naive needs BENCH_MODE=1).
HOLD_STRATEGY=conditional
# 1 turns off rate limits and allows the X-Bench-Strategy header (and naive). Load tests only:
# NODE_ENV=production does not refuse it, because the bench stack runs in production mode,
# so never set it on a deployment that real users can reach.
BENCH_MODE=0
PG_POOL_MAX=20
PG_CONNECT_TIMEOUT_MS=10000
COOKIE_SECURE=0
# 1 when running behind nginx, so req.ip is the client address.
TRUST_PROXY=0

# Tests only: the database and Redis DB the API test suite uses.
# TEST_DB_NAME=seatlock_test
# TEST_REDIS_DB=1
